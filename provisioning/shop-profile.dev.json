  "api": {
    "_comment": "The CARUNO front signs each user in through POST /api/index.php/login and keeps the returned token; logout calls /login with reset=1. Users also need user:self:creer (see roles.dev.json).",
    "enable_login_api": true
  },

  "pricing": {
