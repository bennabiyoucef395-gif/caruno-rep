  "barcode": {
    "default_product_type": "EAN13"
  },

  "stock": {
    "disallow_negative": true,
    "_decrease_on": "Chosen by each shop. bill: stock leaves when the invoice is validated (counter sale = invoice -> validate -> payment). shipment: stock leaves when the shipment is validated (every sale, counter included, goes order -> shipment -> invoice). The CARUNO front adapts its sale flow to this value.",
