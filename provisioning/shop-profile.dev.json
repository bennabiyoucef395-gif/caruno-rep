  },

  "warehouses": [
    { "label": "Magasin", "location": "HANOUT VW (DEV) - surface de vente", "description": "Stock vendable en magasin" },
    { "label": "Réserve", "location": "HANOUT VW (DEV) - réserve", "description": "Stock de réserve" }
  ],

  "bank_accounts": [
