{
  "_comment": "CARUNO shop profile for the HANOUT VW development instance. No secrets here. Identity values are fictitious and marked DEV.",
  "admin_login": "admin",

  "modules": {
    "enable": ["modCategorie", "modBarcode", "modAgenda"],
    "disable": ["modPaymentByBankTransfer", "modVariants"]
  },

  "company": {
    "name": "HANOUT VW (DEV)",
    "address": "1 rue Fictive (DEV - ne pas utiliser)",
    "zip": "16000",
    "town": "Alger",
    "state_id": 17,
    "legal_form_code": "1301",
    "capital": "100000",
    "phone": "+213 000 00 00 00",
    "email": "dev@hanout-vw.invalid",
    "profid": {
      "rc": "DEV-RC-0000000",
      "nif": "DEV-NIF-000000000000000",
      "ai": "DEV-AI-00000000000",
      "nis": "DEV-NIS-000000000000000"
    }
